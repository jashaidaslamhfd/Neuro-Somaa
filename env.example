# French channel defaults
CHANNEL_LANGUAGE=fr
PUBLISH_TIMEZONE=Europe/Paris
TARGET_MIN_SECONDS=15
TARGET_MAX_SECONDS=22
OUTPUT_DIR=output
DATA_DIR=data

# Retention/quality gates — a script below either threshold is rejected
# before rendering (see src/content.py: score_hook / score_script_quality)
MIN_HOOK_SCORE=70
QUALITY_APPROVAL_THRESHOLD=60

# Background music under narration (see src/audio.py + assets/music/ATTRIBUTION.md)
# MUSIC_SOURCE must stay "own" — only the repo's original own_*.wav tracks are
# verified Content-ID-safe; nothing else is auto-selected.
BACKGROUND_MUSIC=true
MUSIC_SOURCE=own
MUSIC_GAIN_DB=-20

# French TTS voice tuning (edge-tts)
EDGE_FR_VOICE=fr-FR-HenriNeural
EDGE_FR_RATE=-5%

# Primary/fallback LLM credentials
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
ALT_LLM_API_KEY=

# YouTube OAuth upload credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REFRESH_TOKEN=
YT_PRIVACY_STATUS=private
YT_SCHEDULE_PUBLISH=true

# Optional visual provider credentials
GEMINI_API_KEY=
REPLICATE_API_TOKEN=
HF_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
COVERR_API_KEY=
AI_HORDE_API_KEY=
DEEPAI_API_KEY=
MODELSLAB_API_KEY=
POLLINATIONS_KEY=

# Other existing integration names retained for future adapters
YOUTUBE_API_KEY=
FB_ACCESS_TOKEN=
FB_PAGE_ID=
INSTAGRAM_USER_ID=

# Local operation
VIDEO_TOPIC=
DRY_RUN=true
