# French channel defaults
CHANNEL_LANGUAGE=fr
PUBLISH_TIMEZONE=Europe/Paris
TARGET_MIN_SECONDS=15
TARGET_MAX_SECONDS=30
OUTPUT_DIR=output
DATA_DIR=data

# Primary/fallback LLM credentials
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
ALT_LLM_API_KEY=

# YouTube OAuth upload credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REFRESH_TOKEN=
YT_PRIVACY_STATUS=private
YT_SCHEDULE_PUBLISH=true

# Optional visual provider credentials
GEMINI_API_KEY=
REPLICATE_API_TOKEN=
HF_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
AI_HORDE_API_KEY=
DEEPAI_API_KEY=
MODELSLAB_API_KEY=
POLLINATIONS_KEY=

# Other existing integration names retained for future adapters
YOUTUBE_API_KEY=
FB_ACCESS_TOKEN=
FB_PAGE_ID=
INSTAGRAM_USER_ID=

# Local operation
VIDEO_TOPIC=
DRY_RUN=true
