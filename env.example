# LLM
GROQ_API_KEY=

# Trend research — Google Trends RSS works without a key. YouTube and Reddit
# use official APIs and are optional; they improve reliability over scraping.
TREND_REGION=FR
YOUTUBE_REGION_CODE=FR
# 500-episode micro-niche launch. Do not force unrelated daily news trends.
# CONTENT_SERIES selects the EDITORIAL ANGLE applied on top of the 500 topics:
#   dark_psychology_fr = Dark Psychology — manipulation, biais cognitifs,
#     secrets du comportement humain. France-first.
CONTENT_SERIES=dark_psychology_fr
TOPIC_STRATEGY=dark_psychology_series_fr
REQUIRE_DAILY_TREND=false
CHANNEL_LANGUAGE=fr-FR
CHANNEL_COUNTRY=FR
KOKORO_LANG_CODE=f
KOKORO_VOICE=ff_siwis
# Primary TTS = Microsoft neural French (edge), robust against the Kokoro
# truncated-audio bug. Switch to TTS_ENGINE=kokoro to use Kokoro instead.
# EDGE_FR_VOICE is tried first; on failure it auto-falls-through to
# EDGE_FR_VOICE_ALT1 then ALT2 before Kokoro. fr-FR-HenriNeural is the proven
# reliable one; fr-FR-RemyNeural is a nicer tone but intermittently returns
# "No audio received" on the runner, so it is kept as an alternative.
# EDGE_FR_RATE slight negative keeps delivery clear for native + learner ears.
TTS_ENGINE=edge
EDGE_FR_VOICE=fr-FR-HenriNeural
EDGE_FR_VOICE_ALT1=fr-FR-RemyNeural
EDGE_FR_VOICE_ALT2=fr-FR-DeniseNeural
EDGE_FR_RATE=-8%
REQUIRE_CLONED_VOICE=false
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Premium competitor-learning layer. The system learns title/tag PATTERNS from
# public French Shorts that crossed COMPETITOR_MIN_VIEWS, then creates original
# metadata for our videos. It does not exact-copy competitor titles/tags.
USE_COMPETITOR_INTEL=true
COMPETITOR_INTEL_PATH=data/competitor_intel_fr.json
USE_TITLE_BANDIT=true
TITLE_BANDIT_PATH=data/title_bandit_fr.json
USE_DYNAMIC_SCHEDULE=false
DYNAMIC_SCHEDULE_PATH=data/upload_slot_intel_fr.json
DYNAMIC_SCHEDULE_SLOT_COUNT=3
FRANCOPHONE_LOCALE_TAGS=true
# Competitor channels are optional. Leave COMPETITOR_CHANNEL_IDS blank and the
# system will auto-discover French high-view winners from the queries below.
COMPETITOR_CHANNEL_IDS=
COMPETITOR_QUERIES_FR=psychologie sombre shorts français|manipulation shorts français|biais cognitifs shorts français|secrets du comportement shorts français|loi du pouvoir shorts français|science comportement shorts français|relations amoureuses shorts français|dark psychology shorts français|ce qu'on ne te dit pas shorts français|mind control shorts français
COMPETITOR_MIN_VIEWS=1000000
COMPETITOR_MAX_DURATION_SECONDS=90
COMMENTS_INTEL_PATH=data/comments_intel_fr.json
AUTO_REPAIR_MIN_AGE_HOURS=48
AUTO_REPAIR_LOW_VIEW_THRESHOLD=200

# YouTube OAuth user credentials (service accounts cannot upload to a normal channel)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REFRESH_TOKEN=
# REFRESH_TOKEN must be minted with all four scopes below. Run
# scripts/reauthorize_youtube_analytics.py locally, then update the GitHub
# Actions REFRESH_TOKEN secret; never commit the token or client JSON.
#   https://www.googleapis.com/auth/youtube.upload
#   https://www.googleapis.com/auth/youtube.force-ssl
#   https://www.googleapis.com/auth/youtube.readonly
#   https://www.googleapis.com/auth/yt-analytics.readonly
YT_MADE_FOR_KIDS=false
# Safety first: review every generated science video before making it public.
# With YT_PRIVACY_STATUS=private and YT_SCHEDULE_PUBLISH=true, YouTube accepts
# a scheduled publishAt and makes the video public at that time. This template
# matches the unattended production workflow; set YT_SCHEDULE_PUBLISH=false for
# manual review that stays private indefinitely.
YT_PRIVACY_STATUS=private
YT_SCHEDULE_PUBLISH=true
# Honest YouTube altered/synthetic content disclosure (AI voice + AI visuals).
YT_DECLARE_SYNTHETIC_MEDIA=true
# Auto-add each Short to its SEO-suggested series playlist.
YT_PLAYLIST_ENABLED=true

# Optional image providers
HF_API_KEY=
GEMINI_API_KEY=
DEEPAI_API_KEY=
MODELSLAB_API_KEY=
REPLICATE_API_TOKEN=
PEXELS_API_KEY=
PIXABAY_API_KEY=
AI_HORDE_API_KEY=

# Optional Facebook. Disabled by default while YouTube videos are privately
# reviewed; Facebook Reels otherwise publish immediately.
FB_ACCESS_TOKEN=
FB_PAGE_ID=
FB_UPLOAD_ENABLED=true
INSTAGRAM_USER_ID=

# Production duration policy: 20–24 second, six-scene Short.
TARGET_MIN_SECONDS=20
TARGET_MAX_SECONDS=24
# These MUST match .github/workflows/main.yml, otherwise a local
# `python src/main.py` accepts scripts that production would reject
# (previously 70/60 here vs 85/85 in CI). tests/test_runtime_config.py
# now enforces that they stay identical.
MIN_HOOK_SCORE=70
MAX_HOOK_SECONDS=6.0
QUALITY_APPROVAL_THRESHOLD=60
# Share of scenes allowed to come from non-generated media (stock/screenshot)
# before the run aborts as visually generic.
FALLBACK_ABORT_RATIO=0.80
# Natural YouTube clone profile. Use a clean 30–60 second single-speaker
# WAV at VOICE_REFERENCE_PATH for the closest identity match.
CHATTERBOX_TEMPO=0.96
CHATTERBOX_EXAGGERATION=0.35
CHATTERBOX_CFG_WEIGHT=0.70
CHATTERBOX_TEMPERATURE=0.60
# Uses an actual track from assets/music. Leave empty to rotate among all
# supported files there, or set an exact filename to lock one track.
MUSIC_TRACK=
MUSIC_VOLUME=0.07
ENABLE_SCREENSHOT_FALLBACK=false
VOICE_REFERENCE_PATH=assets/voice_reference.wav
# Durable repository-backed state (committed by GitHub Actions).
VIDEO_HISTORY_PATH=data/video_history.json
UPLOAD_STATE_PATH=data/upload_state.json
VIDEO_TOPIC=
