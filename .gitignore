.venv/
venv/
env/

# ---- Secrets (CRITICAL) ----
.env
.env.*
!env.example

# ---- Generated run artifacts (never commit; kept in Actions artifacts) ----
pipeline.log
*.log
output/*
!output/gitkeep

# ---- Auth / token artifacts (CRITICAL — never commit these) ----
oauth_backup.json
client_secrets*.json
client_secret*.json
token*.json
*.token
secrets*.json
