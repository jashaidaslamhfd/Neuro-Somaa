__pycache__/
*.pyc

# ---- Local environment / virtualenvs ----
.venv/
venv/
env/

# ---- Secrets (CRITICAL) ----
# UPDATE_ONLY_MANIFEST.md tells the operator to run `git add .`; without this
# rule that single command publishes GROQ_API_KEY + the Google OAuth refresh
# token to a PUBLIC repo. env.example stays tracked as the documented template.
.env
.env.*
!env.example

# ---- Generated run artifacts (never commit; kept in Actions artifacts) ----
pipeline.log
*.log
output/*
!output/gitkeep

# ---- Auth / token artifacts (CRITICAL — never commit these) ----
oauth_backup.json
client_secrets*.json
client_secret*.json
token*.json
*.token
secrets*.json
**/oauth_backup.json

# Private voice-clone reference — keep locally, never on a public repo.
assets/voice_reference.wav

# ML feedback-loop runtime state (regenerated every run)
data/script_history.json
