__pycache__/
*.pyc

# ---- Local environment / virtualenvs ----
.venv/
venv/
env/

# ---- Secrets (CRITICAL) ----
.env
.env.*
!env.example

# ---- Generated run artifacts (never commit; kept in Actions artifacts) ----
pipeline.log
*.log
output/*

# ---- Auth / token artifacts (CRITICAL — never commit these) ----
oauth_backup.json
client_secrets*.json
client_secret*.json
token*.json
*.token
secrets*.json
**/oauth_backup.json

# Private voice-clone reference — keep locally, never on a public repo.
assets/voice_reference.wav

# ML feedback-loop runtime state (regenerated every run)
data/script_history.json
src/script_generator.py.bak
data/next_video_10k.json

# ---- Operational data (CRITICAL — never commit to public repo) ----
# video_history.json is kept tracked (needed on fresh clones).
# queue_index_fr.json / clip_history.json are also kept tracked: main.py's
# _persist_state() commits them after every run so the topic-queue pointer
# and cross-run clip-dedup survive the next scheduled run's fresh checkout —
# previously they were silently un-persistable because of the blanket
# data/*.json rule below, so every run reset the pointer to 0.
# Everything else is runtime-generated and synced via GitHub Actions artifacts.
data/*.json
data/*.md
!data/video_history.json
!data/body_glitch_topics.json
!data/queue_index_fr.json
!data/clip_history.json
